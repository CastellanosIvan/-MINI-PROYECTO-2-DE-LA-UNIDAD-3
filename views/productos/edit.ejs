<%- include('../partials/header', { title: 'Editar Producto' }) %>

<div class="card narrow">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h2 style="margin: 0;">✏️ Editar Producto</h2>
        <a class="btn btn-gray btn-sm" href="/productos">Volver</a>
    </div>

    <p style="font-size: 0.88rem; color: #94a3b8;">
        Validación requerida mediante <strong>UpdateProductoRequest</strong>. Autorización por <strong>ProductoPolicy</strong>.
    </p>

    <form method="POST" action="/productos/<%= producto.id %>?_method=PUT" novalidate>
        <label for="nombre">Nombre del producto</label>
        <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>" required>
        <% if (typeof errors !== 'undefined' && errors.nombre) { %><div class="error"><%= errors.nombre %></div><% } %>

        <label for="descripcion">Descripción</label>
        <textarea id="descripcion" name="descripcion" rows="3"><%= producto.descripcion %></textarea>
        <% if (typeof errors !== 'undefined' && errors.descripcion) { %><div class="error"><%= errors.descripcion %></div><% } %>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
                <label for="precio">Precio ($ MXN)</label>
                <input type="number" step="0.01" id="precio" name="precio" value="<%= producto.precio %>" required>
                <% if (typeof errors !== 'undefined' && errors.precio) { %><div class="error"><%= errors.precio %></div><% } %>
            </div>
            <div>
                <label for="existencia">Existencia (Stock)</label>
                <input type="number" id="existencia" name="existencia" value="<%= producto.existencia %>" required>
                <% if (typeof errors !== 'undefined' && errors.existencia) { %><div class="error"><%= errors.existencia %></div><% } %>
            </div>
        </div>

        <label>Categorías asociadas (belongsToMany)</label>
        <div style="background: #0f111a; border: 1px solid #33384f; border-radius: 6px; padding: 12px; max-height: 150px; overflow-y: auto;">
            <% const prodCatIds = producto.categorias ? producto.categorias.map(c => c.id) : []; %>
            <% categorias.forEach(function(cat) { %>
                <label style="display: flex; align-items: center; gap: 8px; margin: 4px 0; font-weight: normal; cursor: pointer;">
                    <input type="checkbox" name="categorias" value="<%= cat.id %>" <%= prodCatIds.includes(cat.id) ? 'checked' : '' %> style="width: auto;">
                    <span><%= cat.nombre %></span>
                </label>
            <% }); %>
        </div>

        <div style="margin-top: 24px; display: flex; gap: 10px;">
            <button class="btn" type="submit">Actualizar Producto</button>
            <a class="btn btn-gray" href="/productos">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
