<%- include('../partials/header', { title: 'Nuevo Usuario' }) %>

<div class="card narrow">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h2 style="margin: 0;">➕ Registrar Usuario</h2>
        <a class="btn btn-gray btn-sm" href="/usuarios">Volver</a>
    </div>

    <p style="font-size: 0.88rem; color: #94a3b8;">
        Solo accesible por rol <strong>Administrador</strong> (validado por <code>UsuarioPolicy::create</code>).
    </p>

    <form method="POST" action="/usuarios" novalidate>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" value="<%= typeof form !== 'undefined' && form.nombre ? form.nombre : '' %>" required>
                <% if (typeof errors !== 'undefined' && errors.nombre) { %><div class="error"><%= errors.nombre %></div><% } %>
            </div>
            <div>
                <label for="apellidos">Apellidos</label>
                <input type="text" id="apellidos" name="apellidos" value="<%= typeof form !== 'undefined' && form.apellidos ? form.apellidos : '' %>" required>
                <% if (typeof errors !== 'undefined' && errors.apellidos) { %><div class="error"><%= errors.apellidos %></div><% } %>
            </div>
        </div>

        <label for="correo">Correo Institucional</label>
        <input type="email" id="correo" name="correo" value="<%= typeof form !== 'undefined' && form.correo ? form.correo : '' %>" placeholder="ejemplo@tuxtla.tecnm.mx" required>
        <% if (typeof errors !== 'undefined' && errors.correo) { %><div class="error"><%= errors.correo %></div><% } %>

        <label for="clave">Contraseña (clave)</label>
        <input type="password" id="clave" name="clave" placeholder="Mínimo 3 caracteres" required>
        <% if (typeof errors !== 'undefined' && errors.clave) { %><div class="error"><%= errors.clave %></div><% } %>

        <label for="rol">Rol (rol)</label>
        <select id="rol" name="rol" required>
            <option value="cliente">Cliente</option>
            <option value="gerente">Gerente</option>
            <option value="administrador">Administrador</option>
        </select>
        <% if (typeof errors !== 'undefined' && errors.rol) { %><div class="error"><%= errors.rol %></div><% } %>

        <div style="margin-top: 24px; display: flex; gap: 10px;">
            <button class="btn" type="submit">Crear Usuario</button>
            <a class="btn btn-gray" href="/usuarios">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
