<%- include('../partials/header', { title: 'Editar Usuario' }) %>

<div class="card narrow">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h2 style="margin: 0;">✏️ Editar Usuario</h2>
        <a class="btn btn-gray btn-sm" href="/usuarios">Volver</a>
    </div>

    <p style="font-size: 0.88rem; color: #94a3b8;">
        Controlado mediante <strong>UsuarioPolicy::update</strong>.
    </p>

    <form method="POST" action="/usuarios/<%= usuario.id %>?_method=PUT" novalidate>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" value="<%= usuario.nombre %>" required>
                <% if (typeof errors !== 'undefined' && errors.nombre) { %><div class="error"><%= errors.nombre %></div><% } %>
            </div>
            <div>
                <label for="apellidos">Apellidos</label>
                <input type="text" id="apellidos" name="apellidos" value="<%= usuario.apellidos %>" required>
                <% if (typeof errors !== 'undefined' && errors.apellidos) { %><div class="error"><%= errors.apellidos %></div><% } %>
            </div>
        </div>

        <label for="correo">Correo Electrónico</label>
        <input type="email" id="correo" name="correo" value="<%= usuario.correo %>" required>
        <% if (typeof errors !== 'undefined' && errors.correo) { %><div class="error"><%= errors.correo %></div><% } %>

        <label for="clave">Nueva Contraseña (dejar en blanco para no modificar)</label>
        <input type="password" id="clave" name="clave" placeholder="Opcional">
        <% if (typeof errors !== 'undefined' && errors.clave) { %><div class="error"><%= errors.clave %></div><% } %>

        <label for="rol">Rol del Usuario</label>
        <% if (user.rol === 'administrador') { %>
            <select id="rol" name="rol" required>
                <option value="cliente" <%= usuario.rol === 'cliente' ? 'selected' : '' %>>Cliente</option>
                <option value="gerente" <%= usuario.rol === 'gerente' ? 'selected' : '' %>>Gerente</option>
                <option value="administrador" <%= usuario.rol === 'administrador' ? 'selected' : '' %>>Administrador</option>
            </select>
        <% } else { %>
            <input type="text" value="<%= usuario.rol.toUpperCase() %>" readonly style="background: #161824; color: #94a3b8;">
            <input type="hidden" name="rol" value="<%= usuario.rol %>">
            <span style="font-size: 0.78rem; color: #eab308; display: block; margin-top: 4px;">* Como Gerente no puedes modificar roles de usuarios.</span>
        <% } %>

        <div style="margin-top: 24px; display: flex; gap: 10px;">
            <button class="btn" type="submit">Actualizar Usuario</button>
            <a class="btn btn-gray" href="/usuarios">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
