<%- include('../partials/header', { title: 'Registrar Compra / Pedido' }) %>

<div class="card narrow">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h2 style="margin: 0;">🛍️ <%= user.rol === 'cliente' ? 'Comprar Refacción' : 'Registrar Venta' %></h2>
        <a class="btn btn-gray btn-sm" href="/productos">Volver al catálogo</a>
    </div>

    <form method="POST" action="/ventas" novalidate id="formVenta">
        <label for="producto_id">Refacción o Herramienta a comprar</label>
        <select id="producto_id" name="producto_id" required onchange="calcularTotal()">
            <option value="">-- Selecciona un producto --</option>
            <% productos.forEach(function(p) { %>
                <option value="<%= p.id %>" 
                        data-precio="<%= p.precio %>" 
                        data-stock="<%= p.existencia %>"
                        data-vendedor="<%= p.vendedor ? p.vendedor.nombre + ' ' + p.vendedor.apellidos : '' %>"
                        <%= (typeof selectedProductoId !== 'undefined' && selectedProductoId == p.id) ? 'selected' : '' %>>
                    <%= p.nombre %> — $<%= Number(p.precio).toFixed(2) %> (Disponibles: <%= p.existencia %>)
                </option>
            <% }); %>
        </select>
        <% if (typeof errors !== 'undefined' && errors.producto_id) { %><div class="error"><%= errors.producto_id %></div><% } %>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px;">
            <div>
                <label for="cantidad">Cantidad</label>
                <input type="number" id="cantidad" name="cantidad" value="1" min="1" required oninput="calcularTotal()">
                <% if (typeof errors !== 'undefined' && errors.cantidad) { %><div class="error"><%= errors.cantidad %></div><% } %>
            </div>
            <div>
                <label>Precio Unitario</label>
                <input type="text" id="precio_display" value="$0.00" readonly style="background: #161824; color: #94a3b8;">
            </div>
        </div>

        <% if (user.rol === 'administrador' || user.rol === 'gerente' || user.rol === 'empleado') { %>
            <label for="cliente_id">Cliente Comprador (Venta mostrador)</label>
            <select id="cliente_id" name="cliente_id">
                <% clientes.forEach(function(c) { %>
                    <option value="<%= c.id %>"><%= c.nombre %> <%= c.apellidos %> (<%= c.correo %>)</option>
                <% }); %>
            </select>
        <% } %>

        <!-- Resumen del pedido -->
        <div style="margin-top: 16px; padding: 16px; background: #0f111a; border-radius: 8px; border: 1px solid #282d42;">
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #94a3b8; margin-bottom: 6px;">
                <span>Comprador:</span>
                <strong style="color: #fff;"><%= user.nombre %> <%= user.apellidos %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #94a3b8; margin-bottom: 8px;">
                <span>Vendedor asignado:</span>
                <strong id="vendedor_display" style="color: #fff;">—</strong>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 1.25rem; border-top: 1px solid #23273a; padding-top: 10px;">
                <span>Total a Pagar:</span>
                <strong id="total_display" style="color: #4ade80;">$0.00</strong>
            </div>
        </div>

        <div style="margin-top: 24px; display: flex; gap: 10px;">
            <button class="btn btn-green" type="submit" style="flex: 1;">Confirmar y Procesar Compra</button>
            <a class="btn btn-gray" href="/productos">Cancelar</a>
        </div>
    </form>
</div>

<script>
function calcularTotal() {
    const sel = document.getElementById('producto_id');
    const opt = sel.options[sel.selectedIndex];
    const precio = opt ? parseFloat(opt.dataset.precio || 0) : 0;
    const vendedor = opt ? opt.dataset.vendedor || '—' : '—';
    const cantInput = document.getElementById('cantidad');
    const cantidad = Math.max(1, parseInt(cantInput.value || 1, 10));

    document.getElementById('precio_display').value = '$' + precio.toFixed(2);
    document.getElementById('vendedor_display').innerText = vendedor;
    document.getElementById('total_display').innerText = '$' + (precio * cantidad).toFixed(2) + ' MXN';
}
document.addEventListener('DOMContentLoaded', calcularTotal);
</script>

<%- include('../partials/footer') %>
